<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#333333">


    <FrameLayout
        android:id="@+id/arrowbox"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@drawable/bg_input_field"
        android:layout_marginTop="60dp"
        android:layout_marginLeft="20dp">

        <ImageView
            android:id="@+id/backbutton"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/arrow_back_24dp_e3e3e3_fill0_wght400_grad0_opsz24"/>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/logoBox"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="60dp"
        android:background="@drawable/bg_logo_box"
        android:layout_toEndOf="@id/arrowbox"
        android:layout_marginLeft="100dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/my_logo"/>
    </FrameLayout>

    <TextView
        android:id="@+id/txtNewProfile"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Create New Profile"
        android:textColor="@color/white"
        android:textSize="30dp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_below="@id/logoBox"
        android:layout_marginTop="10dp"/>

    <TextView
        android:id="@+id/txtRegistrationName"
        android:layout_width="100dp"
        android:layout_height="30dp"
        android:layout_below="@id/txtNewProfile"
        android:layout_marginLeft="25dp"
        android:text="Enter Name"
        android:textColor="@color/white" 
        android:layout_marginTop="20dp"
        android:textSize="15dp"/>


    <EditText
        android:id="@+id/btnEnterName"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_below="@id/txtRegistrationName"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="0dp"
        android:layout_marginRight="20dp"
        android:background="@drawable/bg_input_field"
        android:hint="Enter your Name"
        android:padding="10dp"
        android:textColorHint="#888888"
        android:textSize="15dp"
        android:textColor="@color/white"/>

    <TextView
        android:id="@+id/txtOr"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:text="Enter Password"
        android:textColor="@color/white"
        android:layout_marginLeft="25dp"
        android:layout_below="@id/btnEnterName"
        android:layout_marginTop="10dp"/>

    <EditText
        android:id="@+id/btnEnterPassword"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_below="@id/txtOr"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="20dp"
        android:background="@drawable/bg_input_field"
        android:hint="Enter your Password"
        android:textColor="@color/white"
        android:textColorHint="#888888"
        android:textSize="15dp"
        android:padding="10dp"/>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/btnEnterPassword"
        android:layout_marginTop="52dp">

        <LinearLayout
            android:id="@+id/lineartxt"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="70dp"
            android:gravity="center">

            <TextView
                android:id="@+id/txtDoYouHaveAccount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Don't have an account? "
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/tvRegister"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/txtDoYouHaveAccount"
                android:text="Register"
                android:textColor="#4CAF50"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRegCreateNewProfile"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_below="@id/lineartxt"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="20dp"
            android:background="@drawable/bg_logo_box"
            android:gravity="center"
            android:text="Create New Profile"
            android:textColor="@color/white"
            android:textStyle="bold" />

    </RelativeLayout>


</RelativeLayout>