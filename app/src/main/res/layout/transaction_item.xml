<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="12dp"
    android:paddingHorizontal="4dp">

    <!-- Colored Indicator Dot -->
    <FrameLayout
        android:id="@+id/txnIndicatorFrame"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_logo_box">

        <TextView
            android:id="@+id/txnIndicatorIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="+"
            android:textColor="#2196F3"
            android:textSize="18sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Middle Content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTxnLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cash Added"
            android:textColor="#F0F4F8"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTxnTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Mar 25, 2024"
            android:textColor="#8A9BB0"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Amount -->
    <TextView
        android:id="@+id/tvTxnType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:background="@drawable/bg_logo_box"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="+ ₱ 1,000.00"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
